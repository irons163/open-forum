---
import { defaultLocale, localePath, t, type Locale } from '../i18n';
import { siteRepoUrl } from '../lib/site';

const { locale = defaultLocale } = Astro.props as { locale?: Locale };
---

<footer class="site-footer">
  <div class="shell footer-shell">
    <div class="footer-brand">
      <strong>Open Forum</strong>
      <p>{t(locale, 'footer.blurb')}</p>
    </div>
    <div class="footer-links">
      <a href={localePath(locale, 'rankings')}>{t(locale, 'nav.rankings')}</a>
      <a href={localePath(locale, 'community')}>{t(locale, 'nav.community')}</a>
      <a href={localePath('zh-Hant', 'launch')}>{t(locale, 'footer.launch')}</a>
      {siteRepoUrl && <a href={siteRepoUrl}>{t(locale, 'footer.source')}</a>}
    </div>
  </div>
</footer>
