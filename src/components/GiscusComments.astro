---
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const discussionsUrl = import.meta.env.PUBLIC_DISCUSSIONS_URL;
const giscusInstallUrl = 'https://github.com/apps/giscus/installations/new';
const mapping = Astro.props.mapping ?? 'pathname';
const term = Astro.props.term ?? '';
const isReady = [repo, repoId, category, categoryId].every(Boolean);
---

<section class="section-panel comments-panel">
  <div class="section-heading">
    <div>
      <p class="eyebrow">討論區</p>
      <h2>留言與討論</h2>
    </div>
  </div>

  {
    isReady ? (
      <>
        <div class="giscus-host" data-giscus-host>
          <script
            is:inline
            src="https://giscus.app/client.js"
            data-repo={repo}
            data-repo-id={repoId}
            data-category={category}
            data-category-id={categoryId}
            data-mapping={mapping}
            data-term={term}
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="light_protanopia"
            data-lang="zh-TW"
            data-loading="lazy"
            crossorigin="anonymous"
            async
          ></script>
        </div>

        <div class="notice giscus-fallback" data-giscus-fallback hidden>
          <p>頁面留言暫時無法載入。請先到 GitHub Discussions 討論，或請站長完成 giscus 安裝。</p>
          <div class="action-row">
            {discussionsUrl && (
              <a class="button" href={discussionsUrl} target="_blank" rel="noreferrer">
                打開 GitHub Discussions
              </a>
            )}
            <a class="button ghost" href={giscusInstallUrl} target="_blank" rel="noreferrer">
              安裝 giscus App
            </a>
          </div>
        </div>

        <script is:inline>
          (() => {
            const host = document.querySelector('[data-giscus-host]');
            const fallback = document.querySelector('[data-giscus-fallback]');
            if (!host || !fallback) return;

            const showFallback = () => {
              host.setAttribute('hidden', '');
              fallback.removeAttribute('hidden');
            };

            window.addEventListener('message', (event) => {
              if (event.origin !== 'https://giscus.app') return;
              const error = event.data?.giscus?.error;
              if (typeof error !== 'string') return;
              // 「Discussion not found」代表尚無討論串，留言後會自動建立，不是故障。
              if (/not installed on this repository/i.test(error) || /Bad credentials/i.test(error)) {
                showFallback();
              }
            });
          })();
        </script>
      </>
    ) : (
      <div class="notice">
        <p>留言區尚未啟用。請到 GitHub Discussions 參與討論。</p>
        <div class="action-row">
          {discussionsUrl && (
            <a class="button" href={discussionsUrl} target="_blank" rel="noreferrer">
              打開 GitHub Discussions
            </a>
          )}
          <a class="button ghost" href={giscusInstallUrl} target="_blank" rel="noreferrer">
            安裝 giscus App
          </a>
        </div>
      </div>
    )
  }
</section>
