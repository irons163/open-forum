---
import Sparkline from './Sparkline.astro';
import { categoryLabel, defaultLocale, localePath, t, type Locale } from '../i18n';
import type { Project } from '../lib/projects';
import {
  formatCompactNumber,
  formatMomentum,
  getDataHealth,
  projectBlurb,
  relativeDays,
} from '../lib/projects';
import { getStarSparkline } from '../lib/history';

const { project, locale = defaultLocale } = Astro.props as {
  project: Project;
  locale?: Locale;
};
const detailUrl = localePath(locale, `projects/${project.slug}`);
const spark = getStarSparkline(project.fullName, 30);
const health = getDataHealth(project, locale);
const blurb = projectBlurb(project, locale);
---

<article
  class="project-card section-panel"
  data-project-card
  data-category={project.category}
  data-search={`${project.name} ${project.fullName} ${project.owner} ${project.category} ${categoryLabel(locale, project.category)} ${project.language || ''} ${project.description} ${project.highlight} ${project.topics.join(' ')}`.toLowerCase()}
>
  <div class="card-top">
    <span class="pill">{categoryLabel(locale, project.category)}</span>
    {project.language && <span class="pill subtle">{project.language}</span>}
    {health.label && <span class="health-badge">{health.label}</span>}
  </div>

  <div class="owner-meta">
    <img
      src={project.avatarUrl}
      alt={`${project.owner} avatar`}
      width="34"
      height="34"
      loading="lazy"
    />
    <div>
      <strong>{project.name}</strong>
      <span class="muted">@{project.owner}</span>
    </div>
  </div>

  <h3>{project.fullName}</h3>
  <p class="muted">{project.description}</p>
  {locale === 'zh-Hant' && blurb && <p class="highlight-note">{blurb}</p>}

  <Sparkline
    shape={spark}
    class="spark-wide"
    label={t(locale, 'home.sparkLabel', { name: project.fullName })}
  />

  <div class="metric-strip">
    <div>
      <span class="metric-label">Stars</span>
      <strong>{formatCompactNumber(project.stars)}</strong>
    </div>
    <div>
      <span class="metric-label">{t(locale, 'card.momentum')}</span>
      <strong>{formatMomentum(project, locale)}</strong>
    </div>
    <div>
      <span class="metric-label">{t(locale, 'card.activity')}</span>
      <strong style="font-size: 0.8rem;">{relativeDays(project.lastPushedAt, locale)}</strong>
    </div>
  </div>

  <div class="mini-metrics">
    <span>Forks {formatCompactNumber(project.forks)}</span>
    <span>Issues {formatCompactNumber(project.openIssues)}</span>
    <span>Watchers {formatCompactNumber(project.watchers)}</span>
  </div>

  <div class="card-actions">
    <a class="button compact" href={detailUrl}>{t(locale, 'common.details')}</a>
    <a class="button ghost compact" href={project.repoUrl} target="_blank" rel="noreferrer">
      {t(locale, 'common.github')}
    </a>
  </div>
</article>
