---
import ProjectCard from '../ProjectCard.astro';
import {
  allCategoryToken,
  categoryLabel,
  defaultLocale,
  localePath,
  t,
  type Locale,
} from '../../i18n';
import { ui } from '../../i18n/ui';
import { categorySummaries, formatCompactNumber, projects } from '../../lib/projects';

const { locale = defaultLocale } = Astro.props as { locale?: Locale };
const countTemplate = ui[locale]['search.count'];
---

<section class="shell section-panel content-block">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{t(locale, 'explore.eyebrow')}</p>
      <h2>{t(locale, 'explore.title')}</h2>
    </div>
  </div>

  <div class="category-grid">
    {categorySummaries.map((summary) => (
      <button
        class="category-card"
        type="button"
        data-category-jump={summary.name}
      >
        <span class="pill">{categoryLabel(locale, summary.name)}</span>
        <h3>{t(locale, 'explore.count', { count: summary.count })}</h3>
        <p class="muted">
          {t(locale, 'explore.summary', {
            stars: formatCompactNumber(summary.stars),
            active: summary.activeCount,
          })}
        </p>
        {summary.leadProject && (
          <div class="stat-line">
            <span>{t(locale, 'explore.lead')}</span>
            <strong>{summary.leadProject.fullName}</strong>
          </div>
        )}
      </button>
    ))}
  </div>
</section>

<section class="shell section-panel content-block" id="discover-projects" data-discover-section>
  <div class="section-heading">
    <div>
      <p class="eyebrow">{t(locale, 'explore.list.eyebrow')}</p>
      <h2>{t(locale, 'explore.list.title')}</h2>
    </div>
    <a class="button ghost" href={localePath(locale, 'community')}>{t(locale, 'nav.recommend')}</a>
  </div>

  <div class="search-row">
    <label class="visually-hidden" for="project-search-input">{t(locale, 'search.projectLabel')}</label>
    <input
      class="search-input"
      id="project-search-input"
      type="search"
      placeholder={t(locale, 'search.projectPlaceholder')}
      data-project-search
    />
    <div class="search-caption">
      <span class="project-count" data-search-count aria-live="polite">
        {t(locale, 'search.count', { visible: projects.length, total: projects.length })}
      </span>
      <span class="muted">{t(locale, 'search.hint')}</span>
    </div>
    <div class="filter-pills" role="group" aria-label={t(locale, 'search.filterAria')}>
      <button
        class="pill"
        type="button"
        data-category-button
        data-category={allCategoryToken}
        data-active="true"
        aria-pressed="true"
      >
        {t(locale, 'search.all')}
      </button>
      {categorySummaries.map((summary) => (
        <button
          class="pill"
          type="button"
          data-category-button
          data-category={summary.name}
          data-active="false"
          aria-pressed="false"
        >
          {categoryLabel(locale, summary.name)}
        </button>
      ))}
    </div>
  </div>

  {
    projects.length ? (
      <>
        <div class="project-grid">
          {projects.map((project) => (
            <ProjectCard project={project} locale={locale} />
          ))}
        </div>
        <p class="empty-state muted" hidden data-empty-state>
          {t(locale, 'search.empty')}
        </p>
      </>
    ) : (
      <div class="empty-state">
        <p>{t(locale, 'search.syncing')}</p>
      </div>
    )
  }
</section>

<script is:inline define:vars={{ allCategoryToken, countTemplate }}>
  const searchInput = document.querySelector('[data-project-search]');
  const categoryButtons = Array.from(document.querySelectorAll('[data-category-button]'));
  const categoryJumpButtons = Array.from(document.querySelectorAll('[data-category-jump]'));
  const projectCards = Array.from(document.querySelectorAll('[data-project-card]'));
  const emptyState = document.querySelector('[data-empty-state]');
  const searchCount = document.querySelector('[data-search-count]');
  const discoverSection = document.querySelector('[data-discover-section]');
  const params = new URLSearchParams(window.location.search);

  let activeCategory = allCategoryToken;

  const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)');

  function scrollToResults() {
    discoverSection?.scrollIntoView({
      behavior: prefersReducedMotion?.matches ? 'auto' : 'smooth',
      block: 'start',
    });
  }

  function setActiveCategory(nextCategory) {
    activeCategory = nextCategory;

    for (const currentButton of categoryButtons) {
      const isActive = currentButton.getAttribute('data-category') === nextCategory;

      currentButton.setAttribute('data-active', isActive ? 'true' : 'false');
      currentButton.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    }
  }

  function syncUrl() {
    const keyword = (searchInput?.value || '').trim();
    const nextParams = new URLSearchParams(window.location.search);

    nextParams.delete('jump');

    if (keyword) {
      nextParams.set('q', keyword);
    } else {
      nextParams.delete('q');
    }

    if (activeCategory && activeCategory !== allCategoryToken) {
      nextParams.set('category', activeCategory);
    } else {
      nextParams.delete('category');
    }

    const query = nextParams.toString();

    window.history.replaceState(
      null,
      '',
      `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`,
    );
  }

  function applyFilters() {
    const keyword = (searchInput?.value || '').trim().toLowerCase();
    let visibleCount = 0;

    for (const card of projectCards) {
      const category = card.getAttribute('data-category') || '';
      const searchBlob = card.getAttribute('data-search') || '';
      const matchesCategory = activeCategory === allCategoryToken || category === activeCategory;
      const matchesKeyword = !keyword || searchBlob.includes(keyword);
      const visible = matchesCategory && matchesKeyword;

      card.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    if (emptyState) {
      emptyState.hidden = visibleCount !== 0;
    }

    if (searchCount) {
      searchCount.textContent = countTemplate
        .replace('{visible}', String(visibleCount))
        .replace('{total}', String(projectCards.length));
    }
  }

  searchInput?.addEventListener('input', () => {
    applyFilters();
    syncUrl();
  });

  const initialKeyword = params.get('q') || '';
  const initialCategory = params.get('category') || '';
  const shouldJump =
    params.get('jump') === 'discover-projects' ||
    Boolean(initialKeyword) ||
    Boolean(initialCategory);

  if (searchInput && initialKeyword) {
    searchInput.value = initialKeyword;
  }

  if (
    initialCategory &&
    categoryButtons.some((button) => button.getAttribute('data-category') === initialCategory)
  ) {
    setActiveCategory(initialCategory);
  }

  for (const button of categoryButtons) {
    button.addEventListener('click', () => {
      setActiveCategory(button.getAttribute('data-category') || allCategoryToken);
      applyFilters();
      syncUrl();
    });
  }

  for (const button of categoryJumpButtons) {
    button.addEventListener('click', () => {
      const nextCategory = button.getAttribute('data-category-jump') || allCategoryToken;
      setActiveCategory(nextCategory);
      applyFilters();
      syncUrl();
      scrollToResults();
    });
  }

  applyFilters();

  if (shouldJump) {
    requestAnimationFrame(() => {
      scrollToResults();
    });
  }
</script>
