---
import { defaultLocale, localePath, t, type Locale } from '../../i18n';
import { getBriefFreshness, getWeeklyBrief } from '../../lib/projects';
import { discussionsUrl } from '../../lib/site';

const { locale = defaultLocale } = Astro.props as { locale?: Locale };
const weeklyBrief = getWeeklyBrief(locale);
const brief = getBriefFreshness(weeklyBrief.weekLabel);
const briefStamp =
  brief.isCurrent || brief.ageDays === null
    ? weeklyBrief.weekLabel
    : t(locale, 'brief.ageStamp', { label: weeklyBrief.weekLabel, days: brief.ageDays });
---

<section class="shell two-column">
  <div class="section-panel content-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{brief.isCurrent ? t(locale, 'brief.current') : t(locale, 'brief.stale')}</p>
        <h2>{weeklyBrief.headline}</h2>
      </div>
      <span class="pill subtle">{briefStamp}</span>
    </div>

    <p class="muted">{weeklyBrief.summary}</p>

    <div class="list-stack" style="margin-top: 1rem;">
      {weeklyBrief.signals.map((signal) => (
        <article class="stack-item">
          <div class="meta-pair">
            <span class="pill">{signal.label}</span>
          </div>
          <p class="data-kicker" style="margin-top: 0.75rem;">{signal.text}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="section-panel sidebar-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t(locale, 'brief.howto.eyebrow')}</p>
        <h2>{t(locale, 'brief.howto.title')}</h2>
      </div>
    </div>

    <div class="list-stack">
      <div class="flow-step">
        <strong>{t(locale, 'brief.howto.1.title')}</strong>
        <p class="muted">{t(locale, 'brief.howto.1.body')}</p>
      </div>
      <div class="flow-step">
        <strong>{t(locale, 'brief.howto.2.title')}</strong>
        <p class="muted">{t(locale, 'brief.howto.2.body')}</p>
      </div>
      <div class="flow-step">
        <strong>{t(locale, 'brief.howto.3.title')}</strong>
        <p class="muted">{t(locale, 'brief.howto.3.body')}</p>
      </div>
    </div>

    <div class="notice">
      <p>
        <a href={localePath(locale, 'rankings')}>{t(locale, 'brief.link.rankings')}</a>
        {' · '}
        <a href={localePath(locale, 'community')}>{t(locale, 'brief.link.community')}</a>
        {discussionsUrl && (
          <>
            {' · '}
            <a href={discussionsUrl} target="_blank" rel="noreferrer">Discussions</a>
          </>
        )}
      </p>
    </div>
  </div>
</section>
