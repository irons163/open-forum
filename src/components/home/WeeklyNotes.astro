---
import { getBriefFreshness, weeklyBrief } from '../../lib/projects';
import { baseUrl, discussionsUrl } from '../../lib/site';

const brief = getBriefFreshness(weeklyBrief.weekLabel);
const briefStamp =
  brief.isCurrent || brief.ageDays === null
    ? weeklyBrief.weekLabel
    : `${weeklyBrief.weekLabel}・${brief.ageDays} 天前`;
---

<section class="shell two-column">
  <div class="section-panel content-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{brief.isCurrent ? '本週觀察' : '編輯手記'}</p>
        <h2>{weeklyBrief.headline}</h2>
      </div>
      <span class="pill subtle">{briefStamp}</span>
    </div>

    <p class="muted">{weeklyBrief.summary}</p>

    <div class="list-stack" style="margin-top: 1rem;">
      {weeklyBrief.signals.map((signal) => (
        <article class="stack-item">
          <div class="meta-pair">
            <span class="pill">{signal.label}</span>
          </div>
          <p class="data-kicker" style="margin-top: 0.75rem;">{signal.text}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="section-panel sidebar-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">怎麼用這站</p>
        <h2>三分鐘逛完</h2>
      </div>
    </div>

    <div class="list-stack">
      <div class="flow-step">
        <strong>01. 看榜單</strong>
        <p class="muted">到熱度榜找 7 天增量、相對增幅與完整排序，點進感興趣的 repo。</p>
      </div>
      <div class="flow-step">
        <strong>02. 讀精選</strong>
        <p class="muted">首頁編輯區會補一句「為什麼現在值得看」，不只給 star 數字。</p>
      </div>
      <div class="flow-step">
        <strong>03. 參與社群</strong>
        <p class="muted">想收錄新專案就提交推薦；有想法就到 Discussions 或頁面留言區討論。</p>
      </div>
    </div>

    <div class="notice">
      <p>
        <a href={`${baseUrl}rankings/`}>熱度榜</a>
        {' · '}
        <a href={`${baseUrl}community/`}>社群提報</a>
        {discussionsUrl && (
          <>
            {' · '}
            <a href={discussionsUrl} target="_blank" rel="noreferrer">Discussions</a>
          </>
        )}
      </p>
    </div>
  </div>
</section>
