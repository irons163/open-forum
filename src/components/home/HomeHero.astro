---
import Sparkline from '../Sparkline.astro';
import { categoryLabel, defaultLocale, localePath, t, type Locale } from '../../i18n';
import {
  activeProjects,
  breakoutProjects,
  buildTrendState,
  formatCompactNumber,
  formatDate,
  formatDelta,
  lastSyncedAt,
  projects,
  totalStars,
  trendingProjects,
} from '../../lib/projects';
import { getStarSparkline } from '../../lib/history';
import { discussionsUrl, recommendIssueUrl } from '../../lib/site';

const { locale = defaultLocale } = Astro.props as { locale?: Locale };
const spotlightProject = breakoutProjects[0] ?? trendingProjects[0] ?? projects[0];
const movers = trendingProjects.slice(0, 4).map((project) => ({
  project,
  spark: getStarSparkline(project.fullName, 30),
}));
const spotlightSpark = spotlightProject ? getStarSparkline(spotlightProject.fullName, 30) : null;
const rankingsPath = localePath(locale, 'rankings');
const communityPath = localePath(locale, 'community');
---

<section class="shell">
  <div class="announcement-strip">
    <div class="announcement-copy">
      <strong>{t(locale, 'home.announce.title')}</strong>
      <p>
        {t(locale, 'home.announce.body', {
          count: projects.length,
          date: formatDate(lastSyncedAt, locale),
        })}
      </p>
    </div>
    <div class="announcement-meta">
      <a class="button ghost compact" href={rankingsPath}>{t(locale, 'home.announce.rankings')}</a>
      {discussionsUrl && (
        <a class="button ghost compact" href={discussionsUrl} target="_blank" rel="noreferrer">
          {t(locale, 'home.announce.discuss')}
        </a>
      )}
    </div>
  </div>
</section>

<section class="shell hero-grid">
  <div class="hero-card section-panel">
    <p class="eyebrow">{t(locale, 'home.hero.eyebrow')}</p>
    <h1>{t(locale, 'home.hero.title')}</h1>
    <p class="muted hero-lead">{t(locale, 'home.hero.lead')}</p>

    <div class="action-row" style="margin-top: 1.1rem;">
      <a class="button" href={rankingsPath}>{t(locale, 'home.hero.ctaRankings')}</a>
      <a class="button ghost" href={recommendIssueUrl || communityPath}>
        {t(locale, 'home.hero.ctaRecommend')}
      </a>
    </div>

    <div class="mover-rail">
      <div class="spark-caption" style="margin: 0 0 0.35rem;">
        <span>{t(locale, 'home.movers.left')}</span>
        <span>{t(locale, 'home.movers.right')}</span>
      </div>
      {movers.map((mover, index) => (
        <a class="mover-row" href={localePath(locale, `projects/${mover.project.slug}`)}>
          <span class="mover-rank">{String(index + 1).padStart(2, '0')}</span>
          <span class="mover-name">{mover.project.fullName}</span>
          <span class="mover-delta">{formatDelta(mover.project.delta7d)}</span>
          <Sparkline
            shape={mover.spark}
            label={t(locale, 'home.sparkLabel', { name: mover.project.fullName })}
          />
        </a>
      ))}
    </div>
  </div>

  <aside class="hero-aside section-panel">
    <p class="eyebrow">{t(locale, 'home.snapshot.eyebrow')}</p>
    <div class="metric-grid" style="margin-top: 0.9rem;">
      <div class="metric-card">
        <span class="metric-label">{t(locale, 'home.metric.tracked')}</span>
        <strong>{projects.length}</strong>
      </div>
      <div class="metric-card">
        <span class="metric-label">{t(locale, 'home.metric.active30')}</span>
        <strong>{activeProjects}</strong>
      </div>
      <div class="metric-card">
        <span class="metric-label">{t(locale, 'home.metric.totalStars')}</span>
        <strong>{formatCompactNumber(totalStars)}</strong>
      </div>
      <div class="metric-card">
        <span class="metric-label">{t(locale, 'home.metric.synced')}</span>
        <strong style="font-size: 0.95rem;">{formatDate(lastSyncedAt, locale)}</strong>
      </div>
    </div>

    {
      spotlightProject && (
        <div class="stack-item" style="margin-top: 0.85rem;">
          <div class="meta-pair">
            <span class="pill">{categoryLabel(locale, spotlightProject.category)}</span>
            <span class={`trend-badge trend-${buildTrendState(spotlightProject, locale).tone}`}>
              {buildTrendState(spotlightProject, locale).label}
            </span>
          </div>
          <strong class="spotlight-title">{spotlightProject.fullName}</strong>
          <p class="muted">{buildTrendState(spotlightProject, locale).description}</p>

          <Sparkline
            shape={spotlightSpark}
            class="spark-wide"
            label={t(locale, 'home.sparkLabel', { name: spotlightProject.fullName })}
          />
          <div class="spark-caption">
            <span>{formatCompactNumber(spotlightProject.stars)} {t(locale, 'common.stars')}</span>
            <span>7d {formatDelta(spotlightProject.delta7d)}</span>
          </div>

          <div class="card-actions">
            <a class="button compact" href={localePath(locale, `projects/${spotlightProject.slug}`)}>
              {t(locale, 'common.details')}
            </a>
            <a
              class="button ghost compact"
              href={spotlightProject.repoUrl}
              target="_blank"
              rel="noreferrer"
            >
              {t(locale, 'common.github')}
            </a>
          </div>
        </div>
      )
    }
  </aside>
</section>
