---
import { categoryLabel, defaultLocale, localePath, t, type Locale } from '../../i18n';
import {
  buildTrendState,
  formatCompactNumber,
  formatMomentum,
  getEditorialFeaturedProjects,
  getEditorialWatchlist,
} from '../../lib/projects';
import { discussionsUrl } from '../../lib/site';

const { locale = defaultLocale } = Astro.props as { locale?: Locale };
const featured = getEditorialFeaturedProjects(locale);
const watchlist = getEditorialWatchlist(locale);
---

<section class="shell two-column">
  <div class="section-panel content-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t(locale, 'editorial.eyebrow')}</p>
        <h2>{t(locale, 'editorial.title')}</h2>
      </div>
      <a class="button ghost" href={localePath(locale, 'community')}>{t(locale, 'nav.recommend')}</a>
    </div>

    <div class="list-stack">
      {featured.map((entry) => (
        <article class="stack-item">
          <div class="rank-meta">
            <span class="pill">{categoryLabel(locale, entry.project.category)}</span>
            <span class="pill subtle">{entry.angle}</span>
            <span>{entry.kicker}</span>
          </div>
          <h3>{entry.project.fullName}</h3>
          <p class="muted">{entry.summary}</p>
          <p class="data-kicker">{entry.whyNow}</p>
          <div class="rank-meta">
            <span>{formatCompactNumber(entry.project.stars)} {t(locale, 'common.stars')}</span>
            <span>{formatMomentum(entry.project, locale)}</span>
            <span>{buildTrendState(entry.project, locale).label}</span>
          </div>
          <div class="card-actions">
            <a class="button compact" href={localePath(locale, `projects/${entry.project.slug}`)}>
              {t(locale, 'common.details')}
            </a>
            <a class="button ghost compact" href={entry.project.repoUrl} target="_blank" rel="noreferrer">
              {t(locale, 'common.github')}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="section-panel sidebar-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t(locale, 'editorial.topics.eyebrow')}</p>
        <h2>{t(locale, 'editorial.topics.title')}</h2>
      </div>
    </div>

    <div class="list-stack">
      {watchlist.map((item, index) => (
        <div class="flow-step">
          <strong>{String(index + 1).padStart(2, '0')} {item.title}</strong>
          <p class="muted">{item.description}</p>
        </div>
      ))}
    </div>

    {discussionsUrl && (
      <div class="notice">
        <p>
          {t(locale, 'editorial.discuss.before')}
          <a href={discussionsUrl} target="_blank" rel="noreferrer">Discussions</a>
          {t(locale, 'editorial.discuss.after')}
        </p>
      </div>
    )}
  </div>
</section>
