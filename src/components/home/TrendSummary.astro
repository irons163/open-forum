---
import { categoryLabel, defaultLocale, localePath, t, type Locale } from '../../i18n';
import {
  buildTrendState,
  formatCompactNumber,
  formatDate,
  formatMomentum,
  projectBlurb,
  recentlyUpdatedProjects,
  trendingProjects,
} from '../../lib/projects';
import { discussionsUrl } from '../../lib/site';

const { locale = defaultLocale } = Astro.props as { locale?: Locale };
---

<section class="shell two-column">
  <div class="section-panel content-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t(locale, 'trend.rising.eyebrow')}</p>
        <h2>{t(locale, 'trend.rising.title')}</h2>
      </div>
      <a class="button ghost" href={localePath(locale, 'rankings')}>{t(locale, 'trend.rising.cta')}</a>
    </div>

    <div class="list-stack">
      {trendingProjects.map((project, index) => (
        <a class="list-link" href={localePath(locale, `projects/${project.slug}`)}>
          <div class="rank-meta">
            <span class="rank-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="pill">{categoryLabel(locale, project.category)}</span>
          </div>
          <h3>{project.fullName}</h3>
          <p class="muted">{projectBlurb(project, locale)}</p>
          <div class="rank-meta">
            <span>{formatMomentum(project, locale)}</span>
            <span>{buildTrendState(project, locale).label}</span>
            <span>{formatCompactNumber(project.stars)} {t(locale, 'common.stars')}</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <div class="section-panel sidebar-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t(locale, 'trend.recent.eyebrow')}</p>
        <h2>{t(locale, 'trend.recent.title')}</h2>
      </div>
    </div>

    <div class="mini-feed">
      {recentlyUpdatedProjects.map((project) => (
        <a class="mini-feed-item" href={localePath(locale, `projects/${project.slug}`)}>
          <div class="meta-pair">
            <span class="pill">{categoryLabel(locale, project.category)}</span>
            <span>{formatDate(project.lastPushedAt, locale)}</span>
          </div>
          <strong>{project.fullName}</strong>
          <p class="muted">{project.description}</p>
        </a>
      ))}
    </div>

    {discussionsUrl && (
      <div class="notice">
        <p>
          {t(locale, 'trend.discuss.before')}
          <a href={discussionsUrl} target="_blank" rel="noreferrer">Discussions</a>
          {t(locale, 'trend.discuss.after')}
        </p>
      </div>
    )}
  </div>
</section>
