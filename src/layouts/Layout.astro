---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
  getLocaleFromUrl,
  htmlLang,
  ogLocale,
  switchLocalePath,
  t,
  type Locale,
} from '../i18n';
import { baseUrl } from '../lib/site';
import { serializeJsonLd } from '../lib/structured-data';
import { themeColors, themeStorageKey } from '../lib/theme';
import '../styles/global.css';

const {
  title = 'Open Forum',
  description,
  current = 'home',
  noindex = false,
  schema,
  locale: localeProp,
} = Astro.props;

const locale = (localeProp as Locale | undefined) ?? getLocaleFromUrl(Astro.url);
const pageDescription = description ?? t(locale, 'meta.defaultDescription');
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const socialImageUrl = Astro.site
  ? new URL(`${baseUrl}og.png`, Astro.site).toString()
  : undefined;
const toAbsolute = (pathWithQuery: string) =>
  Astro.site ? new URL(pathWithQuery, Astro.site).toString() : undefined;
const alternateZh = toAbsolute(switchLocalePath(Astro.url, 'zh-Hant').split(/[?#]/)[0]);
const alternateEn = toAbsolute(switchLocalePath(Astro.url, 'en').split(/[?#]/)[0]);
---

<!doctype html>
<html lang={htmlLang(locale)} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="icon" href={`${baseUrl}favicon.ico`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Noto+Sans+TC:wght@400;500;700&family=Sora:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta name="theme-color" content={themeColors.light} />
    <script is:inline define:vars={{ themeStorageKey, themeColors }}>
      (() => {
        const root = document.documentElement;
        const systemTheme = () =>
          window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const storedTheme = (() => {
          try {
            const value = window.localStorage?.getItem(themeStorageKey);
            return value === 'light' || value === 'dark' ? value : '';
          } catch {
            return '';
          }
        })();
        const theme = storedTheme || systemTheme();

        root.dataset.theme = theme;
        root.style.colorScheme = theme;

        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute('content', themeColors[theme]);
        }
      })();
    </script>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternateZh && <link rel="alternate" hreflang="zh-Hant" href={alternateZh} />}
    {alternateEn && <link rel="alternate" hreflang="en" href={alternateEn} />}
    {alternateZh && <link rel="alternate" hreflang="x-default" href={alternateZh} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="Open Forum" />
    <meta property="og:locale" content={ogLocale(locale)} />
    {socialImageUrl && (
      <>
        <meta property="og:image" content={socialImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t(locale, 'meta.ogImageAlt')} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {schema && (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(schema)} />
    )}
    <title>{title}</title>
  </head>
  <body>
    <div class="page-backdrop" aria-hidden="true">
      <div class="ambient-orb ambient-orb--warm"></div>
      <div class="ambient-orb ambient-orb--cool"></div>
    </div>
    <a class="skip-link" href="#main-content">{t(locale, 'nav.skip')}</a>
    <SiteHeader current={current} locale={locale} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
