---
import Layout from '../layouts/Layout.astro';
import {
  buildRecommendIssueUrl,
  discovery,
  getUntrackedDiscoveryCandidates,
  hasDiscoveryRun,
} from '../lib/discovery';
import {
  formatCompactNumber,
  formatDate,
  getDataHealth,
  lastSyncedAt,
  projects,
  unhealthyProjects,
} from '../lib/projects';
import { baseUrl, discussionsUrl, recommendIssueUrl, siteRepoUrl } from '../lib/site';

const discoveryCandidates = getUntrackedDiscoveryCandidates(
  projects.map((project) => project.fullName),
).map((candidate) => ({
  ...candidate,
  // Always rebuild so form field ids stay in sync even if the JSON snapshot is old.
  recommendIssueUrl: buildRecommendIssueUrl(siteRepoUrl, candidate),
}));
const discoveryReady = hasDiscoveryRun();

const checklist = [
  {
    title: '首頁與導覽正常',
    items: [
      '首頁、熱度榜、社群、專案詳情都能開啟。',
      '編輯精選與週報沒有過時或空白內容。',
      '搜尋與分類篩選可正常操作。',
    ],
  },
  {
    title: '資料與榜單',
    items: [
      '首頁與熱度榜顯示最新同步日期。',
      '榜單有資料，stars 與 7d 增量合理。',
      '本頁「資料健康度」沒有列抓取失敗或已封存的項目。',
      '本頁「自動發現」有本週候選，或已確認這輪沒有新貨。',
      '若歷史樣本仍短，頁面文案有說明「累積中」。',
    ],
  },
  {
    title: '社群流程',
    items: [
      'Issue 提報表單可開啟、可送出。',
      'Discussions 已啟用，giscus 留言正常顯示。',
      '社群頁收錄標準清楚易懂。',
    ],
  },
  {
    title: '對外分享前',
    items: [
      '手機版版面正常、卡片可讀。',
      'GitHub Pages 已部署最新版本。',
      '親自走一遍：首頁 → 榜單 → 詳情 → 提報。',
    ],
  },
];

const afterLaunch = [
  '上線後 24 小時內再檢查首頁、榜單、社群是否正常。',
  '每天看一眼 Sync GitHub Data 的 job summary，有抓取失敗就處理。',
  '每週看 Discover Candidates 的候選清單，值得追的再貼 approved 走收錄流程。',
  '每週整理提報，維持收錄標準一致。',
  '更新 weekly-brief 與 editorial-notes，讓首頁保持新鮮感。',
];
---

<Layout
  title="站長工具 | Open Forum"
  description="站長用的巡檢清單：確認資料同步、社群流程與對外分享前的最後檢查。"
  current="launch"
  noindex
>
  <section class="shell two-column">
    <div class="section-panel content-block">
      <p class="eyebrow">站長工具</p>
      <h1 class="detail-title">發布更新或對外宣傳前，快速巡檢一遍。</h1>
      <p class="muted">
        這頁給站長使用，一般訪客請從首頁或熱度榜開始。每次大更新、換週報或要貼社群前，可以用這份清單確認狀態。
      </p>

      <div class="action-row">
        <a class="button" href={baseUrl}>回首頁</a>
        <a class="button ghost" href={`${baseUrl}rankings/`}>看熱度榜</a>
      </div>

      <div class="section-heading" style="margin-top: 1.6rem;">
        <div>
          <p class="eyebrow">資料健康度</p>
          <h2>需要處理的追蹤項目</h2>
        </div>
        <span class="pill subtle">最後同步 {formatDate(lastSyncedAt)}</span>
      </div>

      {
        unhealthyProjects.length ? (
          <div class="list-stack">
            {unhealthyProjects.map((project) => (
              <a class="list-link" href={`${baseUrl}projects/${project.slug}/`}>
                <div class="rank-meta">
                  <span class="health-badge">{getDataHealth(project).label}</span>
                  <span class="muted">
                    最後成功抓取 {project.fetchedAt ? formatDate(project.fetchedAt) : '未知'}
                  </span>
                </div>
                <h3>{project.fullName}</h3>
                <p class="muted">{getDataHealth(project).description}</p>
              </a>
            ))}
          </div>
        ) : (
          <div class="notice">
            <p>
              {projects.length} 個追蹤中的 repo 都在正常更新，沒有封存或抓取失敗的項目。
            </p>
            <p class="muted">
              同步失敗時這裡會列出來，Actions 的 Sync GitHub Data 也會在 job summary 標示原因。
            </p>
          </div>
        )
      }

      <div class="section-heading" style="margin-top: 1.8rem;">
        <div>
          <p class="eyebrow">自動發現</p>
          <h2>近期增速高、尚未收錄</h2>
        </div>
        <span class="pill subtle">
          {discoveryReady && discovery.generatedAt
            ? `更新於 ${formatDate(discovery.generatedAt)}`
            : '尚未跑過'}
        </span>
      </div>

      <p class="muted" style="margin-top: 0;">
        每週用 GitHub Search API 掃一輪「年輕 + 高星」的公開 repo，排除已在
        <code>project-seeds.json</code> 的項目。日均增星是估算值（目前 stars ÷ 建立天數），不會自動收錄。
      </p>

      {
        discoveryCandidates.length ? (
          <div class="list-stack" style="margin-top: 1rem;">
            {discoveryCandidates.map((candidate) => (
              <article class="list-link" style="cursor: default;">
                <div class="rank-meta">
                  <span class="pill">{candidate.category}</span>
                  {candidate.language && <span class="pill subtle">{candidate.language}</span>}
                  <span class="muted">{formatCompactNumber(candidate.stars)} stars</span>
                  <span class="muted">≈{candidate.starsPerDay}/天</span>
                  <span class="muted">{candidate.ageDays} 天</span>
                </div>
                <h3>
                  <a href={candidate.repoUrl} target="_blank" rel="noreferrer">
                    {candidate.fullName}
                  </a>
                </h3>
                <p class="muted">{candidate.description || '（沒有 description）'}</p>
                <div class="card-actions" style="margin-top: 0.75rem;">
                  {candidate.recommendIssueUrl ? (
                    <a class="button compact" href={candidate.recommendIssueUrl} target="_blank" rel="noreferrer">
                      開收錄 Issue
                    </a>
                  ) : recommendIssueUrl ? (
                    <a class="button compact" href={recommendIssueUrl} target="_blank" rel="noreferrer">
                      開收錄 Issue
                    </a>
                  ) : null}
                  <a class="button ghost compact" href={candidate.repoUrl} target="_blank" rel="noreferrer">
                    看 GitHub
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="notice" style="margin-top: 1rem;">
            <p>
              {discoveryReady
                ? '這輪沒有符合條件、且尚未收錄的候選。'
                : '還沒產生候選清單。本機可跑 npm run discover:candidates，或在 Actions 手動觸發 Discover Candidates。'}
            </p>
            <p class="muted">{discovery.note}</p>
          </div>
        )
      }
    </div>

    <div class="section-panel sidebar-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">快速入口</p>
          <h2>管理時常用</h2>
        </div>
      </div>

      <div class="list-stack">
        {siteRepoUrl && (
          <a class="list-link" href={siteRepoUrl} target="_blank" rel="noreferrer">
            <h3>GitHub Repo</h3>
            <p class="muted">Actions、Pages 部署與設定。</p>
          </a>
        )}
        {recommendIssueUrl && (
          <a class="list-link" href={recommendIssueUrl} target="_blank" rel="noreferrer">
            <h3>Issue 提報</h3>
            <p class="muted">測試推薦表單是否正常。</p>
          </a>
        )}
        {discussionsUrl && (
          <a class="list-link" href={discussionsUrl} target="_blank" rel="noreferrer">
            <h3>Discussions</h3>
            <p class="muted">社群討論與公告。</p>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="shell two-column">
    <div class="section-panel content-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">巡檢項目</p>
          <h2>發布前檢查</h2>
        </div>
      </div>

      <div class="list-stack">
        {checklist.map((group, index) => (
          <div class="stack-item">
            <strong>{String(index + 1).padStart(2, '0')} {group.title}</strong>
            <ul class="muted" style="margin: 0.75rem 0 0; padding-left: 1.1rem;">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="section-panel sidebar-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">上線後</p>
          <h2>建議節奏</h2>
        </div>
      </div>

      <div class="list-stack">
        {afterLaunch.map((item, index) => (
          <div class="flow-step">
            <strong>{String(index + 1).padStart(2, '0')}</strong>
            <p class="muted">{item}</p>
          </div>
        ))}
      </div>

      <div class="notice">
        <p>資料檔：<code>weekly-brief.json</code>、<code>editorial-notes.json</code>、<code>project-seeds.json</code></p>
      </div>
    </div>
  </section>
</Layout>
