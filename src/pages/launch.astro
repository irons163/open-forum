---
import Layout from '../layouts/Layout.astro';
import { baseUrl, discussionsUrl, recommendIssueUrl, siteRepoUrl } from '../lib/site';

const checklist = [
  {
    title: '首頁與導覽正常',
    items: [
      '首頁、熱度榜、社群、專案詳情都能開啟。',
      '編輯精選與週報沒有過時或空白內容。',
      '搜尋與分類篩選可正常操作。',
    ],
  },
  {
    title: '資料與榜單',
    items: [
      '首頁與熱度榜顯示最新同步日期。',
      '榜單有資料，stars 與 7d 增量合理。',
      '若歷史樣本仍短，頁面文案有說明「累積中」。',
    ],
  },
  {
    title: '社群流程',
    items: [
      'Issue 提報表單可開啟、可送出。',
      'Discussions 已啟用，giscus 留言正常顯示。',
      '社群頁收錄標準清楚易懂。',
    ],
  },
  {
    title: '對外分享前',
    items: [
      '手機版版面正常、卡片可讀。',
      'GitHub Pages 已部署最新版本。',
      '親自走一遍：首頁 → 榜單 → 詳情 → 提報。',
    ],
  },
];

const afterLaunch = [
  '上線後 24 小時內再檢查首頁、榜單、社群是否正常。',
  '每週整理提報，維持收錄標準一致。',
  '更新 weekly-brief 與 editorial-notes，讓首頁保持新鮮感。',
];
---

<Layout
  title="站長工具 | Open Forum"
  description="站長用的巡檢清單：確認資料同步、社群流程與對外分享前的最後檢查。"
  current="launch"
>
  <section class="shell two-column">
    <div class="section-panel content-block">
      <p class="eyebrow">站長工具</p>
      <h1 class="detail-title">發布更新或對外宣傳前，快速巡檢一遍。</h1>
      <p class="muted">
        這頁給站長使用，一般訪客請從首頁或熱度榜開始。每次大更新、換週報或要貼社群前，可以用這份清單確認狀態。
      </p>

      <div class="action-row">
        <a class="button" href={baseUrl}>回首頁</a>
        <a class="button ghost" href={`${baseUrl}rankings/`}>看熱度榜</a>
      </div>
    </div>

    <div class="section-panel sidebar-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">快速入口</p>
          <h2>管理時常用</h2>
        </div>
      </div>

      <div class="list-stack">
        {siteRepoUrl && (
          <a class="list-link" href={siteRepoUrl} target="_blank" rel="noreferrer">
            <h3>GitHub Repo</h3>
            <p class="muted">Actions、Pages 部署與設定。</p>
          </a>
        )}
        {recommendIssueUrl && (
          <a class="list-link" href={recommendIssueUrl} target="_blank" rel="noreferrer">
            <h3>Issue 提報</h3>
            <p class="muted">測試推薦表單是否正常。</p>
          </a>
        )}
        {discussionsUrl && (
          <a class="list-link" href={discussionsUrl} target="_blank" rel="noreferrer">
            <h3>Discussions</h3>
            <p class="muted">社群討論與公告。</p>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="shell two-column">
    <div class="section-panel content-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">巡檢項目</p>
          <h2>發布前檢查</h2>
        </div>
      </div>

      <div class="list-stack">
        {checklist.map((group, index) => (
          <div class="stack-item">
            <strong>{String(index + 1).padStart(2, '0')} {group.title}</strong>
            <ul class="muted" style="margin: 0.75rem 0 0; padding-left: 1.1rem;">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="section-panel sidebar-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">上線後</p>
          <h2>建議節奏</h2>
        </div>
      </div>

      <div class="list-stack">
        {afterLaunch.map((item, index) => (
          <div class="flow-step">
            <strong>{String(index + 1).padStart(2, '0')}</strong>
            <p class="muted">{item}</p>
          </div>
        ))}
      </div>

      <div class="notice">
        <p>資料檔：<code>weekly-brief.json</code>、<code>editorial-notes.json</code>、<code>project-seeds.json</code></p>
      </div>
    </div>
  </section>
</Layout>
