---
import EditorialDesk from '../../components/home/EditorialDesk.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import ProjectExplorer from '../../components/home/ProjectExplorer.astro';
import TrendSummary from '../../components/home/TrendSummary.astro';
import WeeklyNotes from '../../components/home/WeeklyNotes.astro';
import { localePath, t } from '../../i18n';
import Layout from '../../layouts/Layout.astro';
import { buildWebSiteSchema } from '../../lib/structured-data';

const locale = 'en' as const;
const title = t(locale, 'meta.homeTitle');
const description = t(locale, 'meta.homeDescription');
const homeUrl = Astro.site ? new URL(localePath(locale), Astro.site).toString() : undefined;
const schema = homeUrl ? buildWebSiteSchema(homeUrl, 'Open Forum', description, locale) : undefined;
---

<Layout title={title} description={description} current="home" schema={schema} locale={locale}>
  <HomeHero locale={locale} />
  <EditorialDesk locale={locale} />
  <WeeklyNotes locale={locale} />
  <ProjectExplorer locale={locale} />
  <TrendSummary locale={locale} />
</Layout>
