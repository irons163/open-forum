---
import Layout from '../layouts/Layout.astro';
import Sparkline from '../components/Sparkline.astro';
import { getStarSparkline } from '../lib/history';
import {
  activeProjects,
  breakoutProjects,
  buildTrendState,
  discoveryProjects,
  formatCompactNumber,
  formatDate,
  formatDelta,
  formatMomentum,
  formatPercentage,
  getDataHealth,
  lastSyncedAt,
  projects,
  relativeDays,
  scaleLeaderProjects,
  totalStars,
  trendingProjects,
} from '../lib/projects';
import { baseUrl } from '../lib/site';
import { buildRankingSchema } from '../lib/structured-data';

const rankingSchema = Astro.site
  ? buildRankingSchema(projects, (project) =>
      new URL(`${baseUrl}projects/${project.slug}/`, Astro.site).toString(),
    )
  : undefined;

const sortOptions = [
  { key: 'trend', label: '趨勢分數' },
  { key: 'stars', label: 'Stars' },
  { key: 'delta7d', label: '7d 增量' },
  { key: 'growth', label: '相對增幅' },
];
---

<Layout
  title="熱度榜 | Open Forum"
  description="用 stars、近期增量與更新活躍度組成的 GitHub 專案熱度榜。"
  current="rankings"
  schema={rankingSchema}
>
  <section class="shell section-panel content-block">
    <p class="eyebrow">熱度榜</p>
    <h1 class="detail-title">哪些開源專案正在變熱</h1>
    <p class="hero-lead muted">
      趨勢分數綜合 stars、forks、最近 1 天與 7 天的增星，以及最近一次 push 的新鮮度，
      所以老牌超大 repo 不會永遠霸榜，近期竄升的專案也抓得到。
    </p>

    <div class="notice">
      <p class="muted">
        如果某個 repo 顯示「剛開始追蹤」，代表它剛納入觀察名單，等歷史快照累積幾天後就會看到明確增量。
      </p>
    </div>

    <div class="metric-grid" style="margin-top: 1.2rem;">
      <div class="metric-card">
        <span class="metric-label">追蹤專案</span>
        <strong>{projects.length}</strong>
      </div>
      <div class="metric-card">
        <span class="metric-label">近 30 天活躍</span>
        <strong>{activeProjects}</strong>
      </div>
      <div class="metric-card">
        <span class="metric-label">總 stars</span>
        <strong>{formatCompactNumber(totalStars)}</strong>
      </div>
      <div class="metric-card">
        <span class="metric-label">最近同步</span>
        <strong>{formatDate(lastSyncedAt)}</strong>
      </div>
    </div>
  </section>

  <section class="shell section-panel content-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">多種視角</p>
        <h2>不要只看總星數，拆成幾種值得看的榜</h2>
      </div>
    </div>

    <div class="insight-grid">
      <div class="insight-card">
        <div class="meta-pair">
          <p class="eyebrow">7d 增量</p>
          <span class="pill">增量前列</span>
        </div>
        <div class="list-stack">
          {trendingProjects.slice(0, 4).map((project, index) => (
            <a class="list-link compact-link" href={`${baseUrl}projects/${project.slug}/`}>
              <div class="rank-meta">
                <span class="rank-number">{String(index + 1).padStart(2, '0')}</span>
                <span>{formatMomentum(project)}</span>
              </div>
              <h3>{project.fullName}</h3>
              <p class="muted">{project.highlight}</p>
            </a>
          ))}
        </div>
      </div>

      <div class="insight-card">
        <div class="meta-pair">
          <p class="eyebrow">相對增幅</p>
          <span class="pill">快速上升</span>
        </div>
        <div class="list-stack">
          {breakoutProjects.slice(0, 4).map((project, index) => (
            <a class="list-link compact-link" href={`${baseUrl}projects/${project.slug}/`}>
              <div class="rank-meta">
                <span class="rank-number">{String(index + 1).padStart(2, '0')}</span>
                <span>{project.historyDays < 7 ? '觀察中' : `7d ${formatPercentage(project.growthRate7d)}`}</span>
              </div>
              <h3>{project.fullName}</h3>
              <p class="muted">
                {project.historyDays < 7
                  ? '剛開始累積歷史資料，先觀察幾天。'
                  : `相對於一週前，已成長 ${formatPercentage(project.growthRate7d)}。`}
              </p>
            </a>
          ))}
        </div>
      </div>

      <div class="insight-card">
        <div class="meta-pair">
          <p class="eyebrow">值得挖掘</p>
          <span class="pill">潛力專案</span>
        </div>
        <div class="list-stack">
          {discoveryProjects.slice(0, 4).map((project, index) => (
            <a class="list-link compact-link" href={`${baseUrl}projects/${project.slug}/`}>
              <div class="rank-meta">
                <span class="rank-number">{String(index + 1).padStart(2, '0')}</span>
                <span>{buildTrendState(project).label}</span>
              </div>
              <h3>{project.fullName}</h3>
              <p class="muted">{buildTrendState(project).description}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="shell section-panel content-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">大盤</p>
        <h2>大盤代表</h2>
      </div>
    </div>

    <div class="list-stack">
      {scaleLeaderProjects.slice(0, 3).map((project, index) => (
        <a class="list-link compact-link" href={`${baseUrl}projects/${project.slug}/`}>
          <div class="rank-meta">
            <span class="rank-number">{String(index + 1).padStart(2, '0')}</span>
            <span>{formatCompactNumber(project.stars)} stars</span>
          </div>
          <h3>{project.fullName}</h3>
          <p class="muted">{project.highlight}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="shell section-panel content-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">總榜</p>
        <h2>完整熱度排序</h2>
      </div>
    </div>

    <div class="filter-pills" role="group" aria-label="排序方式">
      {sortOptions.map((option, index) => (
        <button
          class="pill"
          type="button"
          data-sort-button
          data-sort={option.key}
          data-active={index === 0 ? 'true' : 'false'}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {option.label}
        </button>
      ))}
    </div>

    {
      projects.length ? (
        <div class="rank-list" style="margin-top: 1.2rem;" data-rank-list>
          {projects.map((project, index) => (
            <article
              class="rank-card section-panel"
              data-rank-card
              data-sort-trend={project.trendScore}
              data-sort-stars={project.stars}
              data-sort-delta7d={project.delta7d}
              data-sort-growth={project.historyDays < 7 ? -1 : project.growthRate7d}
            >
              <div class="rank-number" data-rank-number>{String(index + 1).padStart(2, '0')}</div>
              <div>
                <div class="rank-meta">
                  <span class="pill">{project.category}</span>
                  {project.language && <span class="pill subtle">{project.language}</span>}
                  <span class:list={['trend-badge', `trend-${buildTrendState(project).tone}`]}>
                    {buildTrendState(project).label}
                  </span>
                  {getDataHealth(project).status === 'stale' && (
                    <span class="health-badge">{getDataHealth(project).label}</span>
                  )}
                </div>
                <h3>{project.fullName}</h3>
                <p class="muted">{project.description}</p>
                <p class="data-kicker">{buildTrendState(project).description}</p>
                <div class="rank-meta">
                  <span>{formatCompactNumber(project.stars)} stars</span>
                  <span>{formatMomentum(project)}</span>
                  <span>30d {formatDelta(project.delta30d)}</span>
                  <span>{project.historyDays} 天樣本</span>
                  <span>{project.historyDays < 7 ? '相對增幅累積中' : `7d 成長 ${formatPercentage(project.growthRate7d)}`}</span>
                  <span>趨勢分數 {formatCompactNumber(project.trendScore)}</span>
                  <span>{relativeDays(project.lastPushedAt)}</span>
                  <span>同步於 {formatDate(project.syncedAt)}</span>
                </div>
              </div>
              <div class="rank-side">
                <Sparkline
                  shape={getStarSparkline(project.fullName, 30)}
                  class="spark-wide"
                  label={`${project.fullName} 近 30 天 star 走勢`}
                />
                <a class="button compact" href={`${baseUrl}projects/${project.slug}/`}>詳情</a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>榜單資料同步中，稍後再回來看看。</p>
        </div>
      )
    }
  </section>

  <script is:inline>
    const rankList = document.querySelector('[data-rank-list]');
    const sortButtons = Array.from(document.querySelectorAll('[data-sort-button]'));

    if (rankList && sortButtons.length) {
      const cards = Array.from(rankList.querySelectorAll('[data-rank-card]'));
      const attributeFor = {
        trend: 'data-sort-trend',
        stars: 'data-sort-stars',
        delta7d: 'data-sort-delta7d',
        growth: 'data-sort-growth',
      };

      function applySort(key) {
        const attribute = attributeFor[key] || attributeFor.trend;
        const ordered = [...cards].sort(
          (left, right) =>
            Number(right.getAttribute(attribute)) - Number(left.getAttribute(attribute)),
        );

        for (const [index, card] of ordered.entries()) {
          card.querySelector('[data-rank-number]').textContent = String(index + 1).padStart(2, '0');
          rankList.append(card);
        }

        for (const button of sortButtons) {
          const isActive = button.getAttribute('data-sort') === key;

          button.setAttribute('data-active', isActive ? 'true' : 'false');
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        }
      }

      function syncUrl(key) {
        const params = new URLSearchParams(window.location.search);

        if (key === 'trend') {
          params.delete('sort');
        } else {
          params.set('sort', key);
        }

        const query = params.toString();

        window.history.replaceState(
          null,
          '',
          `${window.location.pathname}${query ? `?${query}` : ''}`,
        );
      }

      for (const button of sortButtons) {
        button.addEventListener('click', () => {
          const key = button.getAttribute('data-sort') || 'trend';

          applySort(key);
          syncUrl(key);
        });
      }

      const initialSort = new URLSearchParams(window.location.search).get('sort');

      if (initialSort && attributeFor[initialSort]) {
        applySort(initialSort);
      }
    }
  </script>
</Layout>
