---
import GiscusComments from '../components/GiscusComments.astro';
import Layout from '../layouts/Layout.astro';
import { baseUrl, discussionsUrl, recommendIssueUrl } from '../lib/site';
---

<Layout
  title="社群與提報 | Open Forum"
  description="推薦值得收錄的開源 repo，參與討論，一起維護這份雷達清單。"
  current="community"
>
  <section class="shell two-column">
    <div class="section-panel content-block">
      <p class="eyebrow">社群</p>
      <h1 class="detail-title">看到好專案？歡迎推薦收錄。</h1>
      <p class="muted">
        這站追蹤的 repo 會每日更新熱度。若你發現值得更多人知道的開源專案，可以透過 Issue 表單提交；
        想聊使用心得或榜單觀察，就到 Discussions 或本頁留言區。
      </p>

      <div class="action-row">
        {recommendIssueUrl && <a class="button" href={recommendIssueUrl}>提交推薦</a>}
        {discussionsUrl && (
          <a class="button ghost" href={discussionsUrl} target="_blank" rel="noreferrer">
            打開 Discussions
          </a>
        )}
      </div>
    </div>

    <div class="section-panel sidebar-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">怎麼參與</p>
          <h2>三步完成</h2>
        </div>
      </div>

      <div class="list-stack">
        <div class="flow-step">
          <strong>01. 填表提報</strong>
          <p class="muted">附上 GitHub repo 連結、分類、推薦理由與適用情境。</p>
        </div>
        <div class="flow-step">
          <strong>02. 等待收錄</strong>
          <p class="muted">站方會依活躍度與品質審核，通過後會加入追蹤清單與熱度同步。</p>
        </div>
        <div class="flow-step">
          <strong>03. 一起討論</strong>
          <p class="muted">深度討論歡迎到 Discussions；本頁下方也可直接留言。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="shell two-column">
    <div class="section-panel content-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">收錄標準</p>
          <h2>提報時請先對照</h2>
        </div>
      </div>

      <div class="list-stack">
        <div class="stack-item">
          <strong>有持續維護</strong>
          <p class="muted">近 30 到 90 天內有 commit、release 或活躍討論。</p>
        </div>
        <div class="stack-item">
          <strong>真的可用或可學</strong>
          <p class="muted">對開發者有參考價值，不是只有概念 demo。</p>
        </div>
        <div class="stack-item">
          <strong>分類清楚</strong>
          <p class="muted">能歸進 AI、前端、工具、後端其中一類。</p>
        </div>
        <div class="stack-item">
          <strong>寫清楚推薦理由</strong>
          <p class="muted">說明亮點、適用情境，或最近為什麼值得追。</p>
        </div>
      </div>
    </div>

    <div class="section-panel sidebar-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">暫不收錄</p>
          <h2>這幾種會先婉拒</h2>
        </div>
      </div>

      <div class="list-stack">
        <div class="flow-step">
          <strong>鏡像或搬運 repo</strong>
          <p class="muted">沒有獨立維護、只是同步他人內容。</p>
        </div>
        <div class="flow-step">
          <strong>資訊過少</strong>
          <p class="muted">缺少 README、使用說明或推薦理由。</p>
        </div>
        <div class="flow-step">
          <strong>純行銷或封閉服務</strong>
          <p class="muted">本站聚焦開源 GitHub repo。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="shell section-panel content-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">討論話題</p>
        <h2>歡迎在 Discussions 開串</h2>
      </div>
    </div>

    <div class="list-stack">
      <div class="stack-item">
        <strong>本週榜單觀察</strong>
        <p class="muted">哪些 repo 7 天增量特別高？你怎麼解讀？可先從 <a href={`${baseUrl}rankings/`}>熱度榜</a> 挑幾個開題。</p>
      </div>
      <div class="stack-item">
        <strong>同類型對比</strong>
        <p class="muted">例如 Supabase vs Appwrite、Next.js vs Astro，分享你的選型經驗。</p>
      </div>
      <div class="stack-item">
        <strong>你在用什麼</strong>
        <p class="muted">實際採用心得往往比 star 數更有參考價值。</p>
      </div>
    </div>
  </section>

  <section class="shell">
    <GiscusComments />
  </section>
</Layout>
